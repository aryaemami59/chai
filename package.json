{
  "author": "Jake Luer <jake@alogicalparadox.com>",
  "name": "chai",
  "type": "module",
  "description": "BDD/TDD assertion library for node.js and the browser. Test framework agnostic.",
  "keywords": [
    "test",
    "assertion",
    "assert",
    "testing",
    "chai"
  ],
  "homepage": "http://chaijs.com",
  "license": "MIT",
  "contributors": [
    "Jake Luer <jake@alogicalparadox.com>",
    "Domenic Denicola <domenic@domenicdenicola.com> (http://domenicdenicola.com)",
    "Veselin Todorov <hi@vesln.com>",
    "John Firebaugh <john.firebaugh@gmail.com>"
  ],
  "version": "0.0.0-development",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaijs/chai"
  },
  "bugs": {
    "url": "https://github.com/chaijs/chai/issues"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "bun": {
        "types": "./dist/index.d.ts",
        "default": "./src/index.ts"
      },
      "module-sync": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "module": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./lib/chai/core/assertions.ts"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsup --config=tsup.config.mts",
    "build:esm": "esbuild --bundle --format=esm --keep-names --outfile=chai.js index.js",
    "format": "prettier --write lib",
    "pretest": "npm run lint && npm run build",
    "test": "npm run test-node && npm run test-chrome",
    "test-node": "c8 --99 --check-coverage mocha --require ./test/bootstrap/index.js test/*.js",
    "test-chrome": "web-test-runner --playwright",
    "lint": "npm run lint:js && npm run lint:format",
    "lint:js": "eslint lib/",
    "lint:format": "prettier --check lib",
    "lint:types": "tsc --noEmit",
    "clean": "rimraf chai.js coverage/ dist/"
  },
  "engines": {
    "node": ">=12"
  },
  "dependencies": {
    "assertion-error": "^2.0.1",
    "check-error": "^2.1.1",
    "deep-eql": "^5.0.1",
    "loupe": "^3.1.0",
    "pathval": "^2.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@eslint/js": "^9.17.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@types/check-error": "^1.0.3",
    "@types/deep-eql": "^4.0.2",
    "@types/pathval": "^1.1.2",
    "@web/dev-server-rollup": "^0.6.1",
    "@web/test-runner": "^0.18.0",
    "@web/test-runner-playwright": "^0.11.0",
    "c8": "^10.1.3",
    "esbuild": "^0.25.0",
    "eslint": "^8.56.0",
    "eslint-plugin-jsdoc": "^48.0.4",
    "mocha": "^10.2.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
